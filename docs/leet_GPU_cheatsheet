**Grid / Block Dimension 계산 공식 (Host 측 C++ 코드)**
'''
// Block Size 정의 (보통 16x16 또는 32x32 = 총 256~1024 스레드)
dim3 blockSize(32, 32);

// Ceil Division (올림) 패턴: N이 Block Size의 배수가 아니어도 전체 Cover 가능
dim3 gridSize((width + blockSize.x - 1) / blockSize.x,
             (height + blockSize.y - 1) / blockSize.y);

// Kernel Launch
matrixKernel<<<gridSize, blockSize>>>(d_input, d_output, width, height);
