**Basics**
*__global__*: CPU에서 호출가능 , GPU에서 실행됨(커널함수)
*__shared__*: GPU내에서만 호출가능 , GPU에서 실행됨
*__host__*: CPU에서 호출, CPU에서 실행


**2D Indexing & Boundary Check 패턴 (행렬용)**
'''
__global__ void matrixKernel(const float* input, float* output, int width, int height) {
    // 1. Thread의 Global 2D 좌표 계산
    int col = blockIdx.x * blockDim.x + threadIdx.x; // X축 = Column
    int row = blockIdx.y * blockDim.y + threadIdx.y; // Y축 = Row

    // 2. Boundary Check (배열 범위 초과 방지)
    if (row < height && col < width) {
        // 1D Flattened Index 계산 (2D -> 1D 메모리 주소 변환)
        int idx = row * width + col;
        output[idx] = input[idx] * 2.0f; // 예시 연산
    }
}
'''


**Shared Memory + Bank Conflict Padding 패턴**
'''
#define TILE_DIM 32

__global__ void sharedMemKernel(const float* input, float* output, int width, int height) {
    // [핵심] Padding 1칸 (+1)을 추가하여 32-way Bank Conflict 방지
    __shared__ float tile[TILE_DIM][TILE_DIM + 1]; 

    int col = blockIdx.x * blockDim.x + threadIdx.x;
    int row = blockIdx.y * blockDim.y + threadIdx.y;

    if (row < height && col < width) {
        // Global Memory -> Shared Memory 로드
        tile[threadIdx.y][threadIdx.x] = input[row * width + col];
    }

    // [필수] 모든 스레드가 Shared Memory 로드를 완료할 때까지 대기
    __syncthreads(); 

    // 이후 tile 메모리 접근하여 연산 수행...
}
